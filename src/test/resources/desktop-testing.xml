<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Demoblaze Desktop Regression Test-Suite" parallel="classes" thread-count="2">
    <test name="Chrome Test Execution">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="ua.solvd.demoblaze.common"/>
        </packages>
    </test>
    <test name="Firefox Test Execution">
        <parameter name="browser" value="firefox"/>
        <parameter name="selenium_url" value="http://localhost:4445/wd/hub"/>
        <packages>
            <package name="ua.solvd.demoblaze.common"/>
        </packages>
    </test>
</suite>